# Python
__pycache__/
*.py[oc]
*.egg-info
.ruff_cache/

# Environments. Both are rebuildable, neither is committed:
#   .venv          uv sync                    (pyproject.toml + uv.lock)
#   .venv-lerobot  requirements-lerobot.txt   (the env the pipeline RUNS in)
.venv*/

# Upstream LIBERO clone, recreated by scripts/setup/bootstrap.sh (carries its own .git)
third_party/

# Every generated artifact lives here -- rollouts, init states, results, logs.
# One line by design: the invariant is that scripts/ is the only thing edited
# and data/ the only thing written to. A new output needs no new ignore rule.
data/
# ...except, at the repo root only, the small shareable outputs: result JSONs/figures and demo videos.
!/data/
/data/*
!/data/results/
!/data/videos/
data/results/demo_r76.mp4

# Staged deletions from the 2026-09-08 reorganization, kept until you are
# satisfied nothing is missing. Empty with:  rm -rf .trash
.trash/

.DS_Store
.env

# Datasets and model weights: large, downloadable or regenerable, never committed.
# (GitHub rejects files over 100 MB; roboturk/ alone is 3.4 GB.)
bert/
*.zip
*.npz
*.npy
*.hdf5
# Screen recordings are 20-300 MB each (HARDWARE_RESULTS/, test_videos/); keep them off git.
*.mov
*.pt
*.safetensors
